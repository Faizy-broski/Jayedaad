{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    // The monorepo base config omits "DOM" (packages/core and ui-native are
    // both DOM-free) — this package renders real DOM elements and needs it
    // (e.g. CountryCodeSelect's onChange reads e.target.value).
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src"]
}
