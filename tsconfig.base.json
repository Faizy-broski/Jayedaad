{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@jayedaad/core": ["packages/core/src"],
      "@jayedaad/core/*": ["packages/core/src/*"],
      "@jayedaad/ui-web": ["packages/ui-web/src"],
      "@jayedaad/ui-web/*": ["packages/ui-web/src/*"],
      "@jayedaad/ui-native": ["packages/ui-native/src"],
      "@jayedaad/ui-native/*": ["packages/ui-native/src/*"]
    }
  }
}
