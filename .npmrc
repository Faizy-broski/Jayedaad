# apps/mobile's EAS Build fails under pnpm's default isolated/symlinked
# node_modules layout — the React Native Gradle plugin's settings.gradle
# resolves react-native's package path via a Node script that pnpm's
# symlink structure breaks ("Included build '.../android/null' does not
# exist", com.facebook.react.settings plugin). node-linker=hoisted is
# Expo's own documented fix for pnpm monorepos
# (https://docs.expo.dev/guides/monorepos/) — flattens node_modules closer
# to npm/yarn classic, which the RN Gradle plugin can resolve correctly.
# Monorepo-wide since pnpm has no per-package node-linker override.
node-linker=hoisted
