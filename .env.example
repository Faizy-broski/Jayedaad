# --- Supabase (Auth + Postgres + Storage) ---
# From your Supabase project: Settings -> API / Settings -> Database
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""

# --- API server hardening ---
# Comma-separated allow-list — apps/web's origin(s) only. Mobile isn't
# subject to CORS. Falls back to localhost:3000 if unset (dev only).
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# --- Cache / real-time counters ---
REDIS_URL="redis://localhost:6379"

# --- Object storage (image pipeline) ---
# Supabase Storage can be used directly (via SUPABASE_URL/keys above) instead
# of a separate S3/GCS bucket — kept here in case an external bucket is chosen.
STORAGE_PROVIDER="supabase" # supabase | s3 | gcs
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- Verification documents (ID cards, ownership proof, tax certificates, etc.) ---
# A SEPARATE, PRIVATE Supabase Storage bucket — must be created with public
# access OFF (these are PII). Unlike photos/logos, documents are never
# served via a public URL; the API always signs a short-lived URL on read
# (services/api/src/documents/documents.service.ts).
SUPABASE_DOCUMENTS_BUCKET="documents"

# --- Listing photos/videos ---
# A separate, PUBLIC Supabase Storage bucket — unlike documents, listing
# media is meant to be publicly viewable, so uploads resolve to plain public
# URLs (services/api/src/listings/listing-media.service.ts), no signing.
SUPABASE_LISTING_MEDIA_BUCKET="listing-media"

# --- User/agent profile pictures ---
# A separate, PUBLIC Supabase Storage bucket — own bucket rather than reusing
# listing-media, since avatars are images-only with a tighter size limit
# (services/api/src/agents/avatar-media.service.ts).
SUPABASE_AVATARS_BUCKET="avatars"

# --- Blog cover images ---
# A separate, PUBLIC Supabase Storage bucket — same reasoning as avatars,
# own bucket rather than reusing listing-media.
SUPABASE_BLOG_COVERS_BUCKET="blog-covers"

# --- Push notifications ---
FCM_SERVER_KEY=""
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_PRIVATE_KEY=""

# --- AI Chatbot ---
LLM_PROVIDER_API_KEY=""

# --- Custom OTP email verification (services/api/src/auth/otp) ---
# Our own backend generates + emails the code via nodemailer — NOT Supabase's
# built-in OTP/magic-link. Requires "Confirm email" turned OFF in the
# Supabase dashboard (Auth -> Providers -> Email) so signUp() returns an
# active session immediately; profiles.email_verified is the real gate.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="no-reply@jayedaad.com"

# --- Google OAuth ---
# No client id/secret here — Google OAuth is brokered entirely by Supabase
# (Auth -> Providers -> Google in the dashboard). These are only used
# client-side to build the OAuth redirect/callback URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
EXPO_PUBLIC_APP_SCHEME="jayedaad"

# --- Web/Mobile client (Supabase Auth is called directly from these apps) ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
EXPO_PUBLIC_API_BASE_URL="http://localhost:3001"
EXPO_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY=""

# Google Places API key (Places API must be enabled, billing account
# required) — powers every Area/Location/Address autocomplete field across
# both apps (apps/web/components/PlacesAutocompleteInput.tsx,
# apps/mobile/src/components/PlacesAutocompleteInput.tsx). Without this,
# fields fall back to plain text input rather than breaking. Same key value
# for both — the Google Cloud Console restriction must allow BOTH a
# Websites/HTTP-referrer check (web) AND direct mobile app requests (which
# send no browser Referer header at all), so an unrestricted or
# App-restricted (not Website-restricted) key is required if one key is
# meant to serve both platforms.
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=""
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=""

# --- Error tracking (Sentry) ---
# Optional and inert until set — no account exists yet. Once created, one
# DSN per platform (or one project, three DSNs). No further code change
# needed after setting these.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
EXPO_PUBLIC_SENTRY_DSN=""
# Only needed for source-map upload at build time (apps/web/next.config.js) —
# safe to leave unset, build just skips that step.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Payments (Stripe) ---
# Optional and inert until set — no account exists yet. Required before any
# paid subscription tier can be checked out; free tiers work regardless.
# Test-mode keys are fine to start. After creating a Stripe account: create
# a Product/Price per paid subscription_tiers row and set its id on that
# row's stripe_price_id column, then point a webhook endpoint at
# <api-url>/subscriptions/webhook and copy its signing secret below.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
